{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TaskHUD",
  "version": "0.1.0",
  "identifier": "com.quentinhamonic.taskhud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TaskHUD",
        "width": 360,
        "height": 480,
        "minWidth": 320,
        "minHeight": 360,
        "maxWidth": 520,
        "maxHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
